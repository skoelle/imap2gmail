# Quell-IMAP (Testkonto bzw. Forward-Ziel)
SOURCE__HOST=imap.example.com
SOURCE__PORT=993
SOURCE__EMAIL=test@example.com
SOURCE__PASSWORD=changeme

# Gmail-Ziel (App-Passwort: https://myaccount.google.com/apppasswords)
GMAIL__EMAIL=you@gmail.com
GMAIL__APP_PASSWORD=changeme
GMAIL__HOST=imap.gmail.com
GMAIL__PORT=993

# ntfy-Benachrichtigung (leer/gesetzt = aus)
NTFY__TOPIC_URL=
#NTFY__TOPIC_URL=https://ntfy.sh/my-topic

# From-Adressen ohne ntfy (kommagetrennt, case-insensitive)
NTFY__BLACKLIST=
#NTFY__BLACKLIST=user@example.org,someone@example.com

# Safety-Net-Polling zusätzlich zu IMAP-IDLE
FALLBACK_POLL_SECONDS=60

STATE_FILE=/data/state.json
